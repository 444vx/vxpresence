<Window x:Class="VxPresence.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vx-presence" Height="540" Width="420"
        Background="#000000" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NAGŁÓWEK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VX-PRESENCE" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Windows Rich Presence Engine" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- CARD: PODGLĄD DANYCH NA ŻYWO -->
        <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="LIVE DISCORD STATUS" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtStatusDetails" Text="🖥️ Windows Desktop" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                <TextBlock x:Name="TxtStatusState" Text="CPU: 0% | RAM: 0%" FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- PANEL OPCJI I PRZEŁĄCZNIKÓW -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,10"/>

            <!-- Autostart Switch -->
            <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="Start with Windows" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13"/>
                    <CheckBox x:Name="ChkAutostart" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Show Hardware Stats Switch -->
            <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="Show CPU &amp; RAM Telemetry" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13"/>
                    <CheckBox x:Name="ChkTelemetry" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Show Active Browser Tabs Switch -->
            <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="Show Active Browser Tab Titles" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13"/>
                    <CheckBox x:Name="ChkShowTabs" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Show Background Apps Switch -->
            <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock Text="Show Background Apps on Desktop" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="13"/>
                    <CheckBox x:Name="ChkBgApps" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- FOOTER -->
        <TextBlock Grid.Row="3" Text="Closing this window minimizes to System Tray" FontSize="10" Foreground="#444444" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>